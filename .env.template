# 获取地址: https://open.feishu.cn/app/ -> 选择你的企业自建应用 -> 凭证与基础信息
FEISHU_APP_ID=cli_a914c526d5f8dbc6
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET_HERE

# [可选修改] 飞书多维表格的各个基座地址与 Token (通常无需修改，已经配置为您的专属默认表)
FEISHU_APP_TOKEN_ASSETS=Oj00bIhGVaq1cNsZsJhcMC58ndd
FEISHU_TABLE_ASSETS=tblC6L0fO7FXP3fI
FEISHU_APP_TOKEN_FACTORY=Cu75bLeuJarqg1s7ysscaNolnPg
FEISHU_TABLE_FACTORY=tbloUrdwqG47ZmgI
FEISHU_APP_TOKEN_SCRIPT=J7OPbwEHqaJMefs1NLecTvA1n2e
